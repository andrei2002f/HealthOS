# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).
#
# Every variable here except TZ is validated by lib/env.ts with Zod on first
# read, and instrumentation.ts forces that read at server startup — so a
# missing or malformed value fails at boot rather than on some later request.
#
# BUILD TIME vs RUNTIME. Most of these are read from the environment when the
# server runs, so one image can be pointed at different environments. The
# exception is NEXT_PUBLIC_*: Next substitutes those textually into the
# bundles during `next build`, which means they are baked into the image and
# must be supplied as --build-arg. They are public by definition — the anon key
# is protected by row-level security, not by secrecy — but the consequence is
# real: an image is tied to one Supabase project and cannot be repointed at
# another without a rebuild. See docs/DECISIONS.md, ADR-0003.

# ── Supabase ────────────────────────────────────────────────────────────────
# Both NEXT_PUBLIC_* values are also needed at build time (--build-arg).
NEXT_PUBLIC_SUPABASE_URL=           # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # public; RLS is what protects the data

# Server-only. Bypasses row-level security — never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string. The app connects as the database owner, so RLS
# is not evaluated on this path; queries filter by user_id in code instead.
DATABASE_URL=

# ── Whoop ───────────────────────────────────────────────────────────────────
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=                 # e.g. https://yourapp.vercel.app/api/whoop/callback
WHOOP_API_HOSTNAME=https://api.prod.whoop.com

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6   # never hardcode a model id in the code

# ── Whoop MCP (AI coach) ────────────────────────────────────────────────────
# Optional. Empty is treated as unset; the context builder covers the coach
# without it.
WHOOP_MCP_URL=
WHOOP_MCP_AUTH_TOKEN=

# ── App ─────────────────────────────────────────────────────────────────────
ALLOWED_EMAIL=                      # single-user gate, enforced in proxy.ts
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENCRYPTION_KEY=                     # >=32 random chars; AES-256-GCM key for Whoop tokens
CRON_SECRET=                        # Bearer token the cron routes require

# Read by Node directly, not through the Zod schema. Business logic must take
# the timezone from config rather than hardcoding it.
TZ=Europe/Bucharest

# ── Tests only ──────────────────────────────────────────────────────────────
# Deliberately a different variable from DATABASE_URL: the integration suite
# truncates every table, and the setup refuses any host that is not local.
# Defaults to the postgres service in docker-compose.yml when unset.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthos
