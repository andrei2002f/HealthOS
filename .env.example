# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                       # Supabase Postgres connection string

# Whoop
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=                 # e.g. https://yourapp.vercel.app/api/whoop/callback
WHOOP_API_HOSTNAME=https://api.prod.whoop.com

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Whoop MCP (AI coach — optional until Week 6)
WHOOP_MCP_URL=
WHOOP_MCP_AUTH_TOKEN=

# App
ALLOWED_EMAIL=                      # restricts auth to a single email
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENCRYPTION_KEY=                     # any long random string (>=32 chars)
CRON_SECRET=                        # shared secret for Vercel Cron endpoints
TZ=Europe/Bucharest
