# Everything excluded here stays out of the build context. Two reasons: a small
# context uploads faster and busts the cache less often, and anything that never
# enters the context can never be baked into a layer by accident.

# Version control and editor state
.git
.gitignore
.gitattributes
# `.git` matches only `.git` — .dockerignore does not treat it as a prefix — so
# without this line the workflow directory is part of the build context, and a
# commit touching only ci.yml invalidates `COPY . .` and re-runs `pnpm build`.
# Measured: 105s of a 136s build, paid for a change the image cannot contain.
.github
.vscode
.idea
.claude

# Reinstalled inside the image from the lockfile; host copies may be built for
# a different platform (this repo is developed on Windows).
node_modules

# Build output — regenerated in the builder stage
.next
tsconfig.tsbuildinfo

# Secrets. The image is built without them and reads them at runtime instead.
.env
.env.*
!.env.example

# Generated by `pnpm build` (Serwist). Copying a stale host-built copy in would
# silently ship an outdated service worker.
public/sw.js
public/sw.js.map

# Not needed to build the app
Dockerfile
.dockerignore
docker-compose.yml
docker
docs
README.md
CLAUDE.md
vercel.json

# Logs and OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db
